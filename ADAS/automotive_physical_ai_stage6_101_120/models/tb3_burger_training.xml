<mujoco model="tb3_burger_training">
  <compiler angle="radian" meshdir="."/>
  <option timestep="0.01" gravity="0 0 -9.81"/>
  <default>
    <geom friction="0.8 0.1 0.1"/>
    <joint damping="0.01"/>
  </default>
  <worldbody>
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.85 0.85 0.85 1"/>
    <body name="base_link" pos="0 0 0.08">
      <freejoint name="base_freejoint"/>
      <geom name="base_geom" type="box" size="0.09 0.07 0.035" mass="1.0" rgba="0.15 0.25 0.8 1"/>
      <site name="imu_site" pos="0 0 0.04" size="0.01"/>
      <body name="left_wheel_link" pos="0 0.085 0">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.033 0.012" euler="1.5708 0 0" mass="0.12" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="right_wheel_link" pos="0 -0.085 0">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.033 0.012" euler="1.5708 0 0" mass="0.12" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="caster_link" pos="-0.07 0 -0.025">
        <geom type="sphere" size="0.018" mass="0.03" rgba="0.25 0.25 0.25 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <velocity name="left_wheel_motor" joint="left_wheel_joint" kv="1" ctrlrange="-20 20"/>
    <velocity name="right_wheel_motor" joint="right_wheel_joint" kv="1" ctrlrange="-20 20"/>
  </actuator>
  <sensor>
    <jointpos name="left_wheel_pos" joint="left_wheel_joint"/>
    <jointpos name="right_wheel_pos" joint="right_wheel_joint"/>
    <jointvel name="left_wheel_vel" joint="left_wheel_joint"/>
    <jointvel name="right_wheel_vel" joint="right_wheel_joint"/>
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <framepos name="base_position" objtype="body" objname="base_link"/>
    <framequat name="base_orientation" objtype="body" objname="base_link"/>
  </sensor>
</mujoco>
